# macOS
.DS_Store

# IDE / editor
.idea/
.vscode/

# Frontend dependencies and generated files
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/coverage/
/frontend/*.tsbuildinfo

# Frontend environment files
/frontend/.env*
!/frontend/.env.example

# Backend dependencies and generated files
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot
/backend/public/storage

# Backend environment and runtime files
/backend/.env
/backend/.env.backup
/backend/.env.production
/backend/storage/logs/*.log
/backend/storage/*.key
/backend/storage/pail/

# Root environment files
/.env
/.env.*
!/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
